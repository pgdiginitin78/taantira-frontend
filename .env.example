# Taantira Frontend Public Configuration (Never place secrets here)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# OpenFreeMap public vector tile style endpoint (No API key required; best-effort public tiles)
VITE_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional self-hosted OSRM route endpoint (Leave empty to show markers only without inventing ETA)
VITE_OSRM_URL=
